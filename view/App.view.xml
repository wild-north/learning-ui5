<mvc:View xmlns:mvc="sap.ui.core.mvc" xmlns:core="sap.ui.core" xmlns="sap.m" xmlns:f="sap.f" controllerName="sap.ui.demo.todo.controller.App" displayBlock="true">
		<App>
			<Page>
				<customHeader>
					<f:ShellBar core:require="{ Helper: 'sap/ui/demo/todo/util/Helper' }" title="{i18n>TITLE}" homeIcon="{:= Helper.resolvePath('./img/logo_ui5.png') }" />
				</customHeader>
				<content>
					<f:DynamicPage>
						<f:header>
							<f:DynamicPageHeader pinnable="false">
								<VBox>
									<Input class="todoInput" id="addTodoItemInput" value="{/newTodo}" placeholder="{i18n>INPUT_PLACEHOLDER}" change=".addTodo" />
									<Text 
										xmlns:core="sap.ui.core"
										core:require="{
											Formatter: 'sap/ui/demo/todo/model/formatter'
										}"
										text="{
											formatter: 'Formatter.formatItemsLeft',
											parts: [
												'/itemsLeftCount',
												'i18n>LABEL_ITEMS_LEFT_PLURAL',
												'i18n>LABEL_ITEMS_LEFT_SINGULAR'
											]
										}" 
										textAlign="End"
										class="sapUiSmallMarginTop" />
								</VBox>
							</f:DynamicPageHeader>
						</f:header>
						<f:content>
							<Table id="todoList"
									items="{path: '/todos', events: {change: '.onUpdateItemsLeftCount'}}"
									mode="None"
									growing="true"
									growingScrollToLoad="true"
									class="sapUiResponsiveMargin">
								<headerToolbar>
									<OverflowToolbar id="toolbar" class="sapUiSizeCompact" visible="{= !${view>/isMobile} }">
										<ToolbarSpacer />
										<SearchField id="searchTodoItemsInput" liveChange=".onSearch" width="20rem"/>
										<SegmentedButton selectedKey="all" selectionChange=".onFilter" class="sapMSegmentedButtonNoAutoWidth">
											<items>
												<SegmentedButtonItem text="{i18n>LABEL_ALL}" key="all"/>
												<SegmentedButtonItem text="{i18n>LABEL_ACTIVE}" key="active"/>
												<SegmentedButtonItem text="{i18n>LABEL_COMPLETED}" key="completed"/>
											</items>
										</SegmentedButton>
										<Button id="clearCompleted" enabled="{/itemsRemovable}" icon="sap-icon://delete" text="{i18n>CLEAR_COMPLETED}" press=".onClearCompleted"/>
									</OverflowToolbar>
								</headerToolbar>
								<infoToolbar>
									<OverflowToolbar id="filterToolbar" visible="false" active="false">
										<Label id="filterLabel"/>
									</OverflowToolbar>
								</infoToolbar>
								
								<columns>
									<Column width="4rem" hAlign="Center">
										<Text text=""/>
									</Column>
									<Column minScreenWidth="Tablet" demandPopin="true">
										<Text text="Title"/>
									</Column>
									<Column minScreenWidth="Desktop" demandPopin="true" hAlign="Center" width="12rem">
										<Text text="Created"/>
									</Column>
									<Column minScreenWidth="Tablet" demandPopin="true" hAlign="Center" width="10rem">
										<Text text="Status"/>
									</Column>
									<Column minScreenWidth="Desktop" demandPopin="true" hAlign="Center" width="10rem">
										<Text text="Priority"/>
									</Column>
									<Column hAlign="Center" width="8rem">
										<Text text="Actions"/>
									</Column>
								</columns>
								
					<items>
						<ColumnListItem type="Active" press=".onRowPress">
							<cells>
								<CheckBox selected="{completed}" select=".onCheckboxSelect" visible="{= !${isEditing}}"/>
								
								<VBox>
									<VBox visible="{= !${isEditing}}">
										<Text text="{title}" class="todoTitle"/>
									</VBox>
									<Input value="{draftData>/editingTodo/title}" visible="{= ${isEditing}}"/>
								</VBox>
								
								<Text 
									core:require="{Formatter: 'sap/ui/demo/todo/model/formatter'}"
									text="{path: 'createdAt', formatter: 'Formatter.formatDate'}"/>
								
								<ObjectStatus 
									core:require="{Formatter: 'sap/ui/demo/todo/model/formatter'}"
									text="{path: 'completed', formatter: 'Formatter.formatStatusText'}"
									state="{path: 'completed', formatter: 'Formatter.formatStatusState'}"/>
								
								<Text text="-" class="sapUiTinyText"/>
								
								<HBox justifyContent="Center">
									<Button icon="sap-icon://save" type="Transparent" press=".onSaveEditedItem" visible="{= ${isEditing}}"/>
									<Button icon="sap-icon://cancel" type="Transparent" press=".onCancelEditedItem" visible="{= ${isEditing}}"/>
									<Button icon="sap-icon://edit" type="Transparent" press=".onSetEditModeForItem" visible="{= !${isEditing}}"/>
									<Button icon="sap-icon://delete" type="Transparent" press=".onDeleteItem" visible="{= !${isEditing}}"/>
								</HBox>
							</cells>
							<customData>
								<core:CustomData key="todo-item-completed" value="{= String(${completed})}" writeToDom="true"/>
							</customData>
						</ColumnListItem>
					</items>
							</Table>
						</f:content>
					</f:DynamicPage>
				</content>

				<footer>
					<OverflowToolbar id="toolbar-footer" visible="{= !!${view>/isMobile} }">
						<SegmentedButton selectedKey="all" selectionChange=".onFilter" class="sapMSegmentedButtonNoAutoWidth">
							<items>
								<SegmentedButtonItem text="All" key="all"/>
								<SegmentedButtonItem text="Active" key="active"/>
								<SegmentedButtonItem text="Completed" key="completed"/>
							</items>
						</SegmentedButton>
						<ToolbarSpacer />
						<Button id="clearCompleted-footer" enabled="{/itemsRemovable}" icon="sap-icon://delete" text="{i18n>CLEAR_COMPLETED}" press=".onClearCompleted"/>
					</OverflowToolbar>
				</footer>

			</Page>
		</App>
</mvc:View>
